# 本地私密配置模板 — 复制为 application-local.yml 后填写，勿提交 Git
#
# 步骤：
# 1. 复制本文件为 application-local.yml（同目录）
# 2. 生成 Jasypt 主密钥（自己记牢，不要提交），加密授权码任选一种：
#    方式 A（先设环境变量，须与启动后端时的主密码一致）：
#      $env:JASYPT_ENCRYPTOR_PASSWORD="主密码"
#      mvn -q compile exec:java "-Dexec.mainClass=org.fjnu305.acm01.tools.JasyptEncryptTool" "-Dexec.args=16位授权码"
#    方式 B（一条命令，适合终端读不到系统环境变量时）：
#      mvn -q compile exec:java "-Dexec.mainClass=org.fjnu305.acm01.tools.JasyptEncryptTool" "-Dexec.args=16位授权码" "-Djasypt.encryptor.password=主密码"
#
# 重要：你曾在聊天里发过授权码，请先在 QQ 邮箱「授权码管理」里作废旧的，再生成新的！

notify:
  email:
    enabled: true
    from: 你的QQ号@qq.com

spring:
  mail:
    host: smtp.qq.com
    port: 587
    username: 你的QQ号@qq.com
    password: ENC(这里粘贴加密工具输出的密文)
    default-encoding: UTF-8
    properties:
      mail.smtp.auth: true
      mail.smtp.starttls.enable: true
