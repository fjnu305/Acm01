<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.fjnu305.acm01.module.solution.mapper.SolutionFavoriteMapper">

    <insert id="insert">
        INSERT INTO solution_favorite (user_id, solution_id)
        VALUES (#{userId}, #{solutionId})
    </insert>

    <delete id="delete">
        DELETE FROM solution_favorite
        WHERE user_id = #{userId} AND solution_id = #{solutionId}
    </delete>

    <select id="exists" resultType="int">
        SELECT COUNT(1)
        FROM solution_favorite
        WHERE user_id = #{userId} AND solution_id = #{solutionId}
    </select>
</mapper>
