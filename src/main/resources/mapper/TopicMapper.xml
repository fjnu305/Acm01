<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.fjnu305.acm01.module.social.mapper.TopicMapper">

    <resultMap id="TopicMap" type="org.fjnu305.acm01.module.social.entity.TopicEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="postCount" column="post_count"/>
        <result property="createdTime" column="created_time"/>
    </resultMap>

    <select id="selectById" resultMap="TopicMap">
        SELECT id, name, description, post_count, created_time
        FROM topic WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="selectAll" resultMap="TopicMap">
        SELECT id, name, description, post_count, created_time
        FROM topic ORDER BY post_count DESC, name
    </select>

    <update id="incrementPostCount">
        UPDATE topic SET post_count = post_count + 1 WHERE id = #{id}
    </update>
</mapper>
