<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.fjnu305.acm01.module.team.mapper.TeamCandidateMapper">

    <select id="selectCandidates" resultType="org.fjnu305.acm01.module.user.entity.UserEntity">
        SELECT id, username, nickname, school, cf_rating
        FROM user
        WHERE deleted = 0 AND status = 1
          AND cf_rating BETWEEN #{ratingMin} AND #{ratingMax}
        <if test="excludeUserIds != null and excludeUserIds.size() > 0">
            AND id NOT IN
            <foreach collection="excludeUserIds" item="uid" open="(" separator="," close=")">
                #{uid}
            </foreach>
        </if>
        ORDER BY cf_rating DESC
        LIMIT #{limit}
    </select>
</mapper>
