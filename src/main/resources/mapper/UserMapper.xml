<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.fjnu305.acm01.module.user.mapper.UserMapper">

    <resultMap id="UserResultMap" type="org.fjnu305.acm01.module.user.entity.UserEntity">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="email" column="email"/>
        <result property="avatar" column="avatar"/>
        <result property="gender" column="gender"/>
        <result property="school" column="school"/>
        <result property="bio" column="bio"/>
        <result property="cfHandle" column="cf_handle"/>
        <result property="atcoderHandle" column="atcoder_handle"/>
        <result property="nowcoderHandle" column="nowcoder_handle"/>
        <result property="luoguHandle" column="luogu_handle"/>
        <result property="cfRating" column="cf_rating"/>
        <result property="solvedCount" column="solved_count"/>
        <result property="acCount" column="ac_count"/>
        <result property="contestCount" column="contest_count"/>
        <result property="status" column="status"/>
        <result property="lastLoginTime" column="last_login_time"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, nickname, email, avatar, gender, school, bio,
        cf_handle, atcoder_handle, nowcoder_handle, luogu_handle,
        cf_rating, solved_count, ac_count, contest_count,
        status, last_login_time, created_time, updated_time, deleted
    </sql>

    <select id="selectByUsername" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE username = #{username} AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectById" resultMap="UserResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE id = #{id} AND deleted = 0
        LIMIT 1
    </select>

    <select id="countByUsername" resultType="int">
        SELECT COUNT(1)
        FROM user
        WHERE username = #{username} AND deleted = 0
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, nickname, email, status, deleted)
        VALUES (#{username}, #{password}, #{nickname}, #{email}, #{status}, 0)
    </insert>

    <update id="updateLastLoginTime">
        UPDATE user
        SET last_login_time = NOW()
        WHERE id = #{id} AND deleted = 0
    </update>
</mapper>
